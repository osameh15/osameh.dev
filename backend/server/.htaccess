Options -Indexes

# Branded HTTP error documents.
#
# These replace the hosting provider's default error template for errors the
# origin generates. ErrorDocument with a local path is an internal subrequest,
# never a redirect, so the original URL and the original status code both
# survive - a 403 stays a 403 carrying our own body.
#
# Two limits are deliberate and documented rather than worked around:
#   * A response the application itself produced already has a body, so Apache
#     does not substitute anything. Every /api/ endpoint therefore keeps its
#     JSON contract; only Apache's own errors are branded.
#   * 502/503/504 (and any 429) generated by the ParsPack edge before the
#     request reaches this server cannot be customised here at all. The
#     directives below cover only the origin-generated case.
ErrorDocument 400 /errors/400.html
ErrorDocument 401 /errors/401.html
ErrorDocument 403 /errors/403.html
ErrorDocument 404 /errors/404.html
ErrorDocument 405 /errors/405.html
ErrorDocument 408 /errors/408.html
ErrorDocument 429 /errors/429.html
ErrorDocument 500 /errors/500.html
ErrorDocument 502 /errors/502.html
ErrorDocument 503 /errors/503.html
ErrorDocument 504 /errors/504.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.osameh\.dev$ [NC]
  RewriteRule ^ https://osameh.dev%{REQUEST_URI} [R=301,L]

  # Deep links are rendered through tiny PHP meta layers so crawlers receive
  # canonical, social, and structured metadata before React boots.
  RewriteRule ^projects/([A-Za-z0-9._-]+)/?$ project.php?repo=$1 [QSA,L]
  RewriteRule ^notes/([a-z0-9-]+)/?$ note.php?slug=$1 [QSA,L]
  RewriteRule ^case-studies/([a-z0-9-]+)/?$ case-study.php?id=$1 [QSA,L]
  RewriteRule ^sitemap\.xml$ sitemap.php [QSA,L]

  # Stable same-origin API URLs.
  RewriteRule ^api/github/repos/?$ api/github.php [QSA,L]
  RewriteRule ^api/github/activity/?$ api/github.php?activity=1 [QSA,L]
  RewriteRule ^api/github/metrics/([A-Za-z0-9._-]+)/?$ api/github.php?metrics=$1 [QSA,L]
RewriteRule ^api/github/meta/([A-Za-z0-9._-]+)/?$ api/github.php?meta=$1 [QSA,L]
  RewriteRule ^api/github/tree/([A-Za-z0-9._-]+)/?$ api/github.php?tree=$1 [QSA,L]
  RewriteRule ^api/github/file/([A-Za-z0-9._-]+)/?$ api/github.php?fileRepo=$1 [QSA,L]
  RewriteRule ^api/github/readme/([A-Za-z0-9._-]+)/?$ api/github.php?repo=$1 [QSA,L]
  RewriteRule ^api/github/images/([A-Za-z0-9._-]+)/?$ api/github.php?images=$1 [QSA,L]
  RewriteRule ^api/contact/?$ api/contact.php [QSA,L]
  RewriteRule ^api/analytics/?$ api/analytics.php [QSA,L]
  RewriteRule ^api/health/?$ api/health.php [QSA,L]
  RewriteRule ^og/projects/([A-Za-z0-9._-]+)\.jpg$ project-og.php?repo=$1 [QSA,L]

  # Backend library includes are not endpoints. They are required by an API
  # entrypoint and must never be reachable on their own. The request is answered
  # by the API's own forbidden endpoint rather than by Apache, so a client of
  # /api/ receives a machine-readable JSON 403 instead of an HTML document.
  # The include itself is still never executed or served.
  RewriteRule ^api/(?:lib/|recaptcha\.php$|config\.php$|health-probe\.php$) api/forbidden.php [L]

  # API requests must never fall through to the SPA document.
  RewriteRule ^api/ - [L]

  # First-class client routes. /resume must be handled explicitly because a
  # real public/resume directory also exists for the PDF asset.
  RewriteRule ^(?:home|about|projects|experience|activity|now|changelog|notes|case-studies|contact|resume|status)/?$ index.html [L]

  # Existing files/directories are served normally. Unknown browser routes are
  # handled internally by not-found.php, which returns a real HTTP 404 carrying
  # our IDE-style 404 shell. This is an internal rewrite, never a redirect, so
  # the browser keeps the original invalid URL.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ not-found.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # reCAPTCHA v3 needs exactly two allowances beyond the baseline policy: the
  # api.js/recaptcha__*.js scripts, and the invisible challenge frame Google
  # renders from its own origins. Nothing else is relaxed - no unsafe-eval, no
  # blanket unsafe-inline, no wildcard hosts - and default-src, object-src,
  # frame-ancestors and base-uri are untouched.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-__JSONLD_CSP_HASH__' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; frame-ancestors 'none'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType application/pdf "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|mjs|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^(?:favicon\.ico|icon-\d+x\d+\.png|apple-touch-icon\.png|pwa-\d+x\d+\.png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^og-cover(?:-social)?\.(?:webp|jpg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "^(?:index\.html|robots\.txt|sitemap\.xml|build-info\.json|manifest\.webmanifest|sw\.js|notes-index\.json|case-studies-index\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.md$">
    Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  # An ErrorDocument target is a real static file, so it also answers a direct
  # request with 200. That is required for the internal subrequest to work, but
  # it must never become an indexable page in its own right: the documents carry
  # a robots meta tag and, here, the header form as well. They are not linked
  # from the application and are not in either sitemap.
  # X-Robots-Tag is scoped with "Header set", exactly like the .md rule above.
  # A directly requested error document answers 200 and is the only response a
  # crawler could index; an actual 4xx/5xx is never indexed. "Header always set"
  # is reserved for the site-wide policy the staging packager owns.
  <FilesMatch "^(?:400|401|403|404|405|408|429|500|502|503|504)\.html$">
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Cache-Control "no-store, max-age=0"
  </FilesMatch>
  # The error stylesheet is not content-hashed, so it must not inherit the
  # immutable one-year policy the hashed bundle assets use.
  <FilesMatch "^error\.css$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
