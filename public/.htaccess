Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.osameh\.dev$ [NC]
  RewriteRule ^ https://osameh.dev%{REQUEST_URI} [R=301,L]

  # Deep links are rendered through tiny PHP meta layers so crawlers receive
  # canonical, social, and structured metadata before React boots.
  RewriteRule ^projects/([A-Za-z0-9._-]+)/?$ project.php?repo=$1 [QSA,L]
  RewriteRule ^notes/([a-z0-9-]+)/?$ note.php?slug=$1 [QSA,L]
  RewriteRule ^case-studies/([a-z0-9-]+)/?$ case-study.php?id=$1 [QSA,L]
  RewriteRule ^sitemap\.xml$ sitemap.php [QSA,L]

  # Stable same-origin API URLs.
  RewriteRule ^api/github/repos/?$ api/github.php [QSA,L]
  RewriteRule ^api/github/activity/?$ api/github.php?activity=1 [QSA,L]
  RewriteRule ^api/github/metrics/([A-Za-z0-9._-]+)/?$ api/github.php?metrics=$1 [QSA,L]
RewriteRule ^api/github/meta/([A-Za-z0-9._-]+)/?$ api/github.php?meta=$1 [QSA,L]
  RewriteRule ^api/github/tree/([A-Za-z0-9._-]+)/?$ api/github.php?tree=$1 [QSA,L]
  RewriteRule ^api/github/file/([A-Za-z0-9._-]+)/?$ api/github.php?fileRepo=$1 [QSA,L]
  RewriteRule ^api/github/readme/([A-Za-z0-9._-]+)/?$ api/github.php?repo=$1 [QSA,L]
  RewriteRule ^api/github/images/([A-Za-z0-9._-]+)/?$ api/github.php?images=$1 [QSA,L]
  RewriteRule ^api/contact/?$ api/contact.php [QSA,L]
  RewriteRule ^api/analytics/?$ api/analytics.php [QSA,L]
  RewriteRule ^api/health/?$ api/health.php [QSA,L]
  RewriteRule ^og/projects/([A-Za-z0-9._-]+)\.jpg$ project-og.php?repo=$1 [QSA,L]

  # API requests must never fall through to the SPA document.
  RewriteRule ^api/ - [L]

  # First-class client routes. /resume must be handled explicitly because a
  # real public/resume directory also exists for the PDF asset.
  RewriteRule ^(?:home|about|projects|experience|activity|now|changelog|notes|case-studies|contact|resume|status)/?$ index.html [L]

  # Existing files/directories are served normally. Unknown browser routes are
  # sent through not-found.php. It intentionally returns HTTP 200 + noindex because
  # ParsPack CDN replaces upstream 404 bodies; React renders the IDE-style 404 UI.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ not-found.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-__JSONLD_CSP_HASH__'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType application/pdf "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|mjs|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <Files "favicon.svg">
    Header set Cache-Control "public, max-age=604800"
  </Files>
  <FilesMatch "^og-cover(?:-social)?\.(?:webp|jpg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "^(?:index\.html|robots\.txt|sitemap\.xml|build-info\.json|manifest\.webmanifest|sw\.js|notes-index\.json|case-studies-index\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.md$">
    Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>
