{
  "name": "osameh-portfolio",
  "version": "5.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-build.mjs && tsc --noEmit && vite build && node scripts/ensure-deploy-files.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "quality": "node scripts/quality-gates.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:sw": "node scripts/verify-sw.mjs",
    "package:staging": "node scripts/package-env.mjs staging",
    "package:production": "node scripts/package-env.mjs production",
    "verify:staging": "node scripts/verify-env.mjs staging",
    "verify:production": "node scripts/verify-env.mjs production",
    "availability:set": "node scripts/set-availability.mjs",
    "mood": "node scripts/set-availability.mjs",
    "mood:list": "node scripts/set-availability.mjs --list",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "lucide-react": "^1.31.0",
    "marked": "^15.0.12",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "@playwright/test": "1.62.1"
  }
}
